# SQLite is used by default for local dev — no setup needed.
DATABASE_URL="file:./dev.db"
# For Postgres (e.g. via docker-compose), use instead:
# DATABASE_URL="postgresql://signalwork:signalwork@localhost:5432/signalwork"

JWT_SECRET="change-me-in-prod"
PORT=4000

# Groq (free tier) — used for AI draft generation. Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Tavily (free tier) — used for AI Lead Scout web search. Get a key at https://tavily.com
TAVILY_API_KEY=""

CORS_ORIGIN="http://localhost:5173"
